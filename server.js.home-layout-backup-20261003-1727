async function restoreAuth() {
  try {
    const cachedCredentials = await authCache.get('youtubei_oauth_credentials');
    if (!cachedCredentials) return;
    const client = await ensureAuthClient();
    await client.session.signIn();
    if (client.session.logged_in) {
      authState = { ...authState, status: 'signed_in', error: '' };
