              </g>
            </g>
          </g>
        </svg>
      </a>
    </div>

    <!-- Center Search Bar with Rich Dropdown -->
    <div class="header-center">
      <form class="search-form" action="/search" method="get">
        <div class="search-wrap">
          <span class="search-leading"><%- icon('search') %></span>
          <input id="searchInput" name="q" value="<%= query %>" placeholder="検索" autocomplete="off" spellcheck="false">
          <button id="searchClear" type="button" class="search-clear" aria-label="検索語句を消去" hidden>×</button>
          <div id="searchSuggestions" class="search-suggestions" hidden></div>
        </div>
        <button class="search-submit" type="submit" aria-label="検索"><%- icon('search') %></button>
        <button id="mobileSearchClose" class="icon-btn mobile-search-close" type="button" aria-label="検索を閉じる">×</button>
      </form>
    </div>

    <!-- Right Controls: Queue, Notifications, Account -->
    <div class="header-right">
      <button id="queueButton" class="icon-btn mobile-header-hide" aria-label="再生キュー" title="再生キュー"><%- icon('playlist') %></button>
      <div class="popover-anchor mobile-header-hide">
        <button id="notificationsButton" class="icon-btn" aria-label="通知" title="通知">
          <%- icon('bell') %>
          <span id="notifBadge" class="notif-badge" hidden></span>
        </button>
        <!-- Notifications Popover -->
        <div id="notificationsPopover" class="header-popover notifications-popover" hidden>
          <div class="popover-header">
            <h3>通知</h3>
            <button id="closeNotifPopover" class="icon-btn-sm" aria-label="閉じる">×</button>
          </div>
          <div id="notificationsList" class="notifications-list">
            <div class="popover-loading">読み込み中…</div>
          </div>
        </div>
      </div>

      <div class="popover-anchor">
        <button id="accountButton" class="account-button" aria-label="アカウント メニュー" title="アカウント">
          <span id="accountAvatar" class="account-avatar"><%= authenticated ? '✓' : 'W' %></span>
        </button>
        <!-- Account Dropdown Menu Popover -->
        <div id="accountMenuPopover" class="header-popover account-popover" hidden>
          <div id="accountUserHeader" class="account-user-header">
            <span class="account-avatar-lg">W</span>
            <div class="account-user-meta">
              <b id="menuAccountName">ログインしていません</b>
              <span id="menuAccountHandle">YouTubeアカウントでログイン</span>
            </div>
          </div>
          <div class="popover-divider"></div>
          <div class="popover-menu-items">
            <a class="popover-item" href="/my-channel"><%- icon('user') %><span>チャンネルを表示</span></a>
            <a class="popover-item" href="/settings"><%- icon('settings') %><span>設定</span></a>
            <button id="themeMenuTrigger" class="popover-item" type="button">
              <%- icon('moon') %>
              <span>デザイン: <b id="currentThemeLabel">ダーク</b></span>
              <%- icon('chevron-right', 'icon menu-arrow') %>
            </button>
            <button id="shortcutsMenuTrigger" class="popover-item" type="button">
              <%- icon('settings') %>
              <span>キーボード ショートカット</span>
            </button>
          </div>
          <div class="popover-divider"></div>
          <div class="popover-menu-items">
            <button id="authMenuAction" class="popover-item" type="button">
              <%- icon('user') %>
              <span id="authMenuLabel"><%= authenticated ? 'ログアウト' : 'テレビ認証でログイン' %></span>
            </button>
          </div>
        </div>
      </div>
      <button id="mobileSearchOpen" class="icon-btn mobile-search-trigger" type="button" aria-label="検索を開く" title="検索">
        <%- icon('search') %>
      </button>
    </div>
  </header>

  <!-- Sidebar / Guide Navigation -->
  <aside class="sidebar" aria-label="メイン ナビゲーション">
    <nav class="sidebar-nav">
      <div class="sidebar-primary">
        <a class="nav-item compact-primary <%= page === 'home' ? 'active' : '' %>" href="/"><%- icon('home') %><span>ホーム</span></a>
        <a class="nav-item compact-primary <%= page === 'shorts' ? 'active' : '' %>" href="/shorts"><%- icon('shorts') %><span>Shorts</span></a>
        <a class="nav-item compact-primary <%= libraryType === 'subscriptions' ? 'active' : '' %>" href="/subscriptions"><%- icon('sub') %><span>登録チャンネル</span></a>
        <a class="nav-item compact-primary <%= page === 'settings' ? 'active' : '' %>" href="/settings"><%- icon('settings') %><span>設定</span></a>
      </div>
      <hr class="sidebar-open-only">
      <section class="sidebar-section you-section">
        <div class="sidebar-open-only sidebar-detail-list">
          <a class="nav-item <%= libraryType === 'history' ? 'active' : '' %>" href="/history"><%- icon('history') %><span>履歴</span></a>
          <a class="nav-item <%= page === 'search' && query === '再生リスト' ? 'active' : '' %>" href="/playlists"><%- icon('playlist') %><span>再生リスト</span></a>
          <a class="nav-item <%= libraryType === 'watchLater' ? 'active' : '' %>" href="/watch-later"><%- icon('clock') %><span>後で見る</span></a>
          <a class="nav-item <%= libraryType === 'likedVideos' ? 'active' : '' %>" href="/liked"><%- icon('like') %><span>高く評価した動画</span></a>
        </div>
      </section>
      <hr class="sidebar-open-only">
      <section class="sidebar-section subscriptions-section sidebar-open-only">
        <div class="sidebar-heading">登録チャンネル</div>
        <div id="sidebarSubscriptions" class="sidebar-channel-list" aria-live="polite">
          <span class="sidebar-skeleton"></span><span class="sidebar-skeleton"></span><span class="sidebar-skeleton"></span>
        </div>
      </section>
      <hr class="sidebar-open-only">
      <section class="sidebar-section explore-section sidebar-open-only">
        <div class="sidebar-heading">探索</div>
        <a class="nav-item" href="/feed/trending"><%- icon('fire') %><span>急上昇</span></a>
        <a class="nav-item" href="/feed/music"><%- icon('music') %><span>音楽</span></a>
        <a class="nav-item" href="/feed/gaming"><%- icon('game') %><span>ゲーム</span></a>
        <a class="nav-item" href="/feed/news"><%- icon('news') %><span>ニュース</span></a>
      </section>
      <footer class="sidebar-footer sidebar-open-only">
        <p>© <%= new Date().getFullYear() %> YouTube Web Client</p>
      </footer>
    </nav>
  </aside>
  <div id="scrim" class="scrim"></div>

  <!-- Main Content Area -->
  <main class="main <%= page === 'watch' ? 'watch-main' : '' %>">
    <% if (page === 'settings') { %>
      <section class="settings-page">
        <header class="settings-page-heading">
          <h1>設定</h1>
          <p>WeTubeの再生や表示を自分好みに変更できます。この設定はこのブラウザに保存されます。</p>
        </header>

        <section class="settings-card" aria-labelledby="settings-playback-title">
          <div class="settings-card-heading">
            <h2 id="settings-playback-title">再生</h2>
            <p>動画を開いたときに使う再生方法や自動再生を設定します。</p>
          </div>
          <label class="settings-row" for="settingsDefaultPlayer">
            <span><b>既定の再生方法</b><small>動画ページを開いたときに最初に使うプレーヤーです。</small></span>
            <select id="settingsDefaultPlayer" class="settings-select">
              <option value="edu">Eduプレーヤー</option>
              <option value="youtube">YouTubeプレーヤー</option>
              <option value="stream">ストリーム</option>
            </select>
          </label>
          <label class="settings-row" for="settingsAutoplay">
            <span><b>次の動画を自動再生</b><small>動画の再生終了後、次の関連動画を再生します。</small></span>
            <input id="settingsAutoplay" class="settings-switch" type="checkbox">
          </label>
        </section>

        <section class="settings-card" aria-labelledby="settings-appearance-title">
          <div class="settings-card-heading">
            <h2 id="settings-appearance-title">表示</h2>
            <p>テーマはサイト全体に適用されます。</p>
          </div>
          <fieldset class="settings-theme-options">
            <legend>テーマ</legend>
            <label><input type="radio" name="settingsThemeSelect" value="device"><span>システム既定</span></label>
            <label><input type="radio" name="settingsThemeSelect" value="dark"><span>ダーク</span></label>
            <label><input type="radio" name="settingsThemeSelect" value="light"><span>ライト</span></label>
          </fieldset>
          <div class="settings-row" aria-live="polite">
            <span><b>テーマの反映</b><small>システム既定では端末の外観設定に合わせて自動で切り替わります。</small></span>
          </div>
        </section>

        <section class="settings-card" aria-labelledby="settings-playback-detail-title">
          <div class="settings-card-heading">
            <h2 id="settings-playback-detail-title">プレーヤーと画面</h2>
            <p>動画ページや一覧の表示動作を調整します。</p>
          </div>
          <label class="settings-row" for="settingsPlaybackSpeed">
            <span><b>既定の再生速度</b><small>対応するプレーヤーで新しい動画を開いたときに適用します。</small></span>
            <select id="settingsPlaybackSpeed" class="settings-select">
              <option value="0.5">0.5 倍</option>
              <option value="0.75">0.75 倍</option>
              <option value="1">標準</option>
              <option value="1.25">1.25 倍</option>
              <option value="1.5">1.5 倍</option>
              <option value="1.75">1.75 倍</option>
              <option value="2">2 倍</option>
            </select>
          </label>
          <label class="settings-row" for="settingsVideoPreviews">
            <span><b>動画のプレビュー</b><small>一覧のサムネイルにカーソルを合わせたとき、動画プレビューを再生します。</small></span>
            <input id="settingsVideoPreviews" class="settings-switch" type="checkbox">
          </label>
          <label class="settings-row" for="settingsCompactGrid">
            <span><b>一覧をコンパクトに表示</b><small>ホームと検索結果に一度に表示する動画を増やします。</small></span>
            <input id="settingsCompactGrid" class="settings-switch" type="checkbox">
          </label>
          <label class="settings-row" for="settingsReduceMotion">
            <span><b>アニメーションを減らす</b><small>画面切り替えやホバー時の動きを抑えます。</small></span>
            <input id="settingsReduceMotion" class="settings-switch" type="checkbox">
          </label>
        </section>

        <section class="settings-card" aria-labelledby="settings-data-title">
          <div class="settings-card-heading">
            <h2 id="settings-data-title">このブラウザのデータ</h2>
            <p>削除してもYouTubeアカウント上の履歴やデータには影響しません。</p>
          </div>
          <div class="settings-row settings-data-row">
            <span><b>検索履歴</b><small>このブラウザに保存された検索語句を削除します。</small></span>
            <button id="clearSearchHistory" class="settings-danger-button" type="button">削除</button>
          </div>
          <div class="settings-row settings-data-row">
            <span><b>視聴履歴</b><small>ログアウト中にこのブラウザへ保存された履歴を削除します。</small></span>
            <button id="clearLocalHistory" class="settings-danger-button" type="button">削除</button>
          </div>
          <div class="settings-row settings-data-row">
            <span><b>再生キュー</b><small>このブラウザの再生待ちリストを空にします。</small></span>
            <button id="clearPlaybackQueue" class="settings-danger-button" type="button">削除</button>
          </div>
        </section>
        <p id="settingsSaveStatus" class="settings-save-status" role="status" aria-live="polite"></p>
      </section>
    <% } %>

    <% if (page === 'home' || page === 'search') { %>
      <% if (page === 'home') { %>
        <!-- Category Filter Chips with Horizontal Scroll Buttons -->
        <div class="chips-container">
          <button id="chipsLeft" class="chips-nav-btn chips-left" aria-label="前へ" hidden><%- icon('chevron-left') %></button>
          <nav id="homeChips" class="home-chips" aria-label="おすすめカテゴリー">
            <a class="home-chip active" href="/">すべて</a>
            <a class="home-chip" href="/feed/trending">急上昇</a>
            <a class="home-chip" href="/feed/music">音楽</a>
            <a class="home-chip" href="/feed/gaming">ゲーム</a>
            <a class="home-chip" href="/feed/news">ニュース</a>
            <a class="home-chip" href="/search?q=アニメ">アニメ</a>
            <a class="home-chip" href="/search?q=料理">料理</a>
            <a class="home-chip" href="/search?q=プログラミング">プログラミング</a>
            <a class="home-chip" href="/search?q=旅行">旅行</a>
          </nav>
          <button id="chipsRight" class="chips-nav-btn chips-right" aria-label="次へ"><%- icon('chevron-right') %></button>
        </div>
      <% } else { %>
        <!-- Search Filters -->
        <div class="search-header-row">
          <div class="chips">
            <% [['all','すべて'],['video','動画'],['channel','チャンネル'],['playlist','再生リスト']].forEach(([type, label]) => { %>
              <a class="chip <%= searchType === type ? 'selected' : '' %>" href="/search?q=<%= encodeURIComponent(query) %>&type=<%= type %>"><%= label %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (page === 'search' && channels.length) { %>
        <section class="channel-results">
          <% channels.forEach(channel => { %>
            <article class="channel-result">
              <a href="/channel/<%= channel.id %>" class="channel-result-avatar-link">
                <% if (channel.thumbnail) { %>
                  <img class="channel-result-avatar" src="<%= channel.thumbnail %>" alt="">
                <% } else { %>
                  <span class="channel-result-avatar fallback"><%= channel.name.slice(0, 1) %></span>
                <% } %>
              </a>
              <div class="channel-result-copy">
                <a class="channel-result-name" href="/channel/<%= channel.id %>"><%= channel.name %></a>
                <span><%= [channel.handle, channel.subscribers, channel.videos].filter(Boolean).join('・') %></span>
                <p><%= channel.description %></p>
              </div>
              <a class="channel-open" href="/channel/<%= channel.id %>">チャンネルを表示</a>
            </article>
          <% }) %>
        </section>
      <% } %>

      <% const standardVideos = page === 'search' ? videos.filter(v => !v.isShort) : videos; %>
      <% const searchShorts = page === 'search' ? videos.filter(v => v.isShort) : []; %>
      <% if (searchShorts.length) { %>
        <section class="search-shorts-shelf" aria-label="Shorts検索結果">
          <div class="search-shorts-heading">
            <h2><%- icon('shorts') %> Shorts</h2>
          </div>
          <div class="search-shorts-row">
            <% searchShorts.forEach(v => { %>
              <article class="search-short-card" data-video-id="<%= v.id %>">
                <a class="search-short-thumb" href="/shorts/<%= encodeURIComponent(v.id) %>">
                  <img src="<%= v.thumbnail %>" alt="" loading="lazy" data-video-fallback="<%= v.id %>">
                  <span class="search-short-badge"><%- icon('shorts') %>Shorts</span>
                </a>
                <div class="search-short-info">
                  <a class="video-title" href="/shorts/<%= encodeURIComponent(v.id) %>"><%= v.title %></a>
                  <% if (v.authorId) { %>
                    <a class="channel-name-link" href="/channel/<%= encodeURIComponent(v.authorId) %>"><%= v.author %></a>
                  <% } else { %>
                    <span><%= v.author || 'チャンネル不明' %></span>
                  <% } %>
                  <span><%= [v.views, v.published].filter(Boolean).join('・') %></span>
                </div>
                <button class="more-btn" aria-label="その他のアクション" data-video-id="<%= v.id %>" data-title="<%= v.title %>"><%- icon('more') %></button>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- Video Grid or Search Results -->
      <section id="<%= page === 'home' ? 'recommendationGrid' : 'searchResults' %>" class="<%= page === 'search' ? 'search-results' : 'video-grid' %>"<% if (page === 'search' && feedToken) { %> data-feed-token="<%= feedToken %>" data-feed-kind="search"<% } %>>
        <% if (page === 'home' && !videos.length) { %>
          <% for (let i = 0; i < 8; i++) { %>
            <article class="video-card recommend-skeleton-card" aria-hidden="true">
              <div class="thumb skeleton-box"></div>
              <div class="card-info">
                <span class="channel-avatar skeleton-circle"></span>
                <div class="card-copy">
                  <span class="skeleton-line skeleton-title"></span>
                  <span class="skeleton-line"></span>
                  <span class="skeleton-line skeleton-short"></span>
                </div>
              </div>
            </article>
          <% } %>
        <% } else { %>
          <% standardVideos.forEach(v => { %>
              <article class="video-card" data-video-id="<%= v.id %>">
                <a class="thumb" href="/watch?v=<%= v.id %>">
                  <img src="<%= v.thumbnail %>" alt="" loading="lazy" data-video-fallback="<%= v.id %>">
                  <% if (v.duration) { %><span class="duration"><%= v.duration %></span><% } %>
                </a>
                <div class="card-info">
                  <% if (v.authorThumbnail) { %>
                    <img class="channel-avatar" src="<%= v.authorThumbnail %>" alt="">
                  <% } else { %>
                    <span class="channel-avatar fallback"><%= (v.author || 'Y').slice(0, 1) %></span>
                  <% } %>
                  <div class="card-copy">
                    <a class="video-title" href="/watch?v=<%= v.id %>"><%= v.title %></a>
                    <% if (v.authorId) { %>
                      <a class="channel-name-link" href="/channel/<%= encodeURIComponent(v.authorId) %>"><%= v.author %></a>
                    <% } else { %>
                      <span><%= v.author || 'チャンネル不明' %></span>
                    <% } %>
                    <span><%= [v.views, v.published].filter(Boolean).join('・') %></span>
                    <% if (page === 'search' && v.description) { %><p><%= v.description %></p><% } %>
                  </div>
                  <button class="more-btn" aria-label="その他のアクション" data-video-id="<%= v.id %>" data-title="<%= v.title %>"><%- icon('more') %></button>
                </div>
              </article>
          <% }) %>
        <% } %>
      </section>

      <% if (page === 'home') { %>
        <% if (shorts && shorts.length) { %>
          <section class="home-shorts-shelf">
            <div class="home-shelf-heading">
              <div>
                <h2><%- icon('shorts') %> Shorts</h2>
              </div>
              <a href="/shorts">すべて見る</a>
            </div>
            <div class="home-shorts-row">
              <% shorts.forEach(v => { %>
                <article class="home-short-card">
                  <a class="home-short-thumb" href="/shorts/<%= v.id %>">
                    <img src="<%= v.thumbnail %>" alt="" loading="lazy" data-video-fallback="<%= v.id %>">
                    <span class="home-short-play"><%- icon('shorts') %></span>
                  </a>
                  <div class="home-short-copy">
                    <a class="home-short-title" href="/shorts/<%= v.id %>"><%= v.title || 'ショート動画' %></a>
                    <div class="home-short-channel">
                      <% if (v.authorThumbnail) { %>
                        <img src="<%= v.authorThumbnail %>" alt="">
                      <% } else { %>
                        <span class="fallback"><%= String(v.author || 'Y').slice(0, 1) %></span>
                      <% } %>
                      <span><%= v.author || 'YouTube' %></span>
                    </div>
                    <small><%= v.views || '' %></small>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        <% } %>
      <% } else if (!videos.length && !channels.length) { %>
        <div class="empty">
          <h2>検索結果が見つかりませんでした</h2>
          <p>別のキーワードで試してください。</p>
        </div>
      <% } %>
    <% } %>

    <!-- Shorts Page -->
    <% if (page === 'shorts') { %>
      <section id="shortsFeed" class="shorts-feed" data-short-token="<%= typeof shortSession !== 'undefined' ? shortSession : '' %>" data-channel-id="<%= typeof shortChannelId !== 'undefined' ? shortChannelId : '' %>">
        <% videos.forEach((short, index) => { %>
          <article class="short-reel" data-short-id="<%= short.id %>" data-short-index="<%= index %>">
            <div class="short-shell">
              <iframe class="short-player"<% if (index === 0) { %> src="<%= short.eduUrl %>"<% } %> data-src="<%= short.eduUrl %>" title="<%= short.title %>" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
              <div class="short-overlay">
                <a href="<%= short.authorId ? '/channel/' + short.authorId : '#' %>" class="short-author">
                  <% if (short.authorThumbnail) { %>
                    <img src="<%= short.authorThumbnail %>" alt="">
                  <% } else { %>
                    <span class="fallback"><%= short.author.slice(0, 1) %></span>
                  <% } %>
                  <b><%= short.author %></b>
                </a>
                <p><%= short.title %></p>
              </div>
            </div>
            <div class="short-actions">
              <button class="short-like" type="button" aria-label="高評価"><%- icon('like') %><span>高評価</span></button>
              <button class="short-comment" type="button" aria-label="コメント"><%- icon('news') %><span>コメント</span></button>
              <button class="short-share" type="button" aria-label="共有"><%- icon('share') %><span>共有</span></button>
              <a href="/watch?v=<%= short.id %>" aria-label="通常再生"><%- icon('screen') %><span>通常再生</span></a>
            </div>
          </article>
        <% }) %>
      </section>
      <div class="short-pager">
        <button id="previousShort" aria-label="前のショート">↑</button>
        <button id="nextShort" aria-label="次のショート">↓</button>
      </div>
      <button id="shortCommentsScrim" class="short-comments-scrim" type="button" aria-label="コメントを閉じる" hidden></button>
      <aside id="shortComments" class="short-comments" aria-hidden="true">
        <header>
          <h2>コメント</h2>
          <button id="closeShortComments" type="button" aria-label="閉じる">×</button>
        </header>
        <div class="short-comment-tools">
          <button type="button" data-short-sort="top" class="active">人気順</button>
          <button type="button" data-short-sort="new">新しい順</button>
        </div>
        <form id="shortCommentComposer" class="short-comment-composer">
          <textarea id="shortCommentText" maxlength="10000" placeholder="コメントを追加..."></textarea>
          <button type="submit">投稿</button>
        </form>
        <div id="shortCommentsList"></div>
      </aside>
    <% } %>

    <!-- Watch Page -->
    <% if (page === 'watch' && video) { %>
      <div class="watch-layout">
        <section class="watch-primary">
          <!-- Player Container -->
          <div id="playerContainer" class="player-container">
            <div class="player-shell">
              <iframe id="player" src="<%= playerMode === 'youtube' ? youtubeUrl : eduUrl %>" title="<%= video.title %>" allow="accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
              <video id="streamPlayer" controls playsinline preload="metadata" hidden></video>
              <!-- Autoplay Countdown Overlay -->
              <div id="autoplayOverlay" class="autoplay-overlay" hidden>
                <div class="autoplay-countdown-box">
                  <div class="autoplay-ring-wrap">
                    <svg class="autoplay-ring" viewBox="0 0 48 48"><circle class="ring-bg" cx="24" cy="24" r="20"/><circle id="ringProgress" class="ring-fg" cx="24" cy="24" r="20"/></svg>
                    <span id="autoplayCountdownNum">5</span>
                  </div>
                  <div class="autoplay-meta">
                    <span>次の動画を自動再生します</span>
                    <b id="autoplayNextTitle"></b>
                  </div>
                  <div class="autoplay-buttons">
                    <button id="cancelAutoplayBtn" class="pill" type="button">キャンセル</button>
                    <button id="playNextNowBtn" class="pill active" type="button">今すぐ再生</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <h1 class="watch-title"><%= video.title %></h1>

          <!-- Toolbar (Channel & Actions) -->
          <div class="watch-toolbar">
            <div class="channel-block">
              <a href="<%= video.authorId ? '/channel/' + video.authorId : '#' %>" class="channel-avatar-link">
                <% if (video.authorThumbnail) { %>
                  <img class="watch-avatar" src="<%= video.authorThumbnail %>" alt="<%= video.author %>">
                <% } else { %>
                  <span class="watch-avatar fallback"><%= video.author.slice(0, 1) %></span>
                <% } %>
              </a>
              <div class="channel-info">
                <% if (video.authorId) { %>
                  <a href="/channel/<%= video.authorId %>" class="channel-name"><%= video.author %></a>
                <% } else { %>
                  <b class="channel-name"><%= video.author %></b>
                <% } %>
                <small class="channel-sub-count"><%= video.subscribers || '' %></small>
              </div>
              <button id="subscribeButton" class="subscribe" data-channel-id="<%= video.authorId %>" data-channel-name="<%= video.author %>" data-channel-avatar="<%= video.authorThumbnail %>">チャンネル登録</button>
            </div>

            <div class="actions">
              <!-- Segmented Like / Dislike Button -->
              <div class="segmented-rating">
                <button id="likeButton" class="pill like-btn" title="高評価">
                  <%- icon('like') %>
                  <span id="likeCountText"><%= video.likeCount || '高評価' %></span>
                </button>
                <div class="rating-divider"></div>
                <button id="dislikeButton" class="pill dislike-btn" title="低評価" aria-label="低評価">
                  <%- icon('dislike') %>
                </button>
              </div>

              <button id="shareButton" class="pill icon-only watch-icon-button" title="共有" aria-label="共有"><%- icon('share') %></button>
              <button id="saveButton" class="pill icon-only watch-icon-button" title="保存" aria-label="保存"><%- icon('clock') %></button>
              <label class="player-mode-control">
                <select id="playerModeSelect" class="player-mode-select" data-mode="<%= playerMode === 'youtube' ? 'youtube' : 'edu:0' %>" data-edu="<%= eduUrl %>" data-youtube="<%= youtubeUrl %>" data-edu-sources='<%- JSON.stringify(eduSources || []) %>' aria-label="再生方法">
                  <option value="youtube" <%= playerMode === 'youtube' ? 'selected' : '' %>>YouTube</option>
                  <% (eduSources || []).forEach((source, index) => { %>
                    <option value="edu:<%= index %>" <%= playerMode !== 'youtube' && index === 0 ? 'selected' : '' %>>Edu <%= index + 1 %></option>
                  <% }); %>
                  <% if (!(eduSources || []).length) { %>
                    <option value="edu:0" <%= playerMode !== 'youtube' ? 'selected' : '' %>>Edu</option>
                  <% } %>
                  <option value="stream">ストリーム</option>
                </select>
              </label>
              <details class="watch-more-controls">
                <summary class="pill icon-only watch-icon-button" aria-label="その他のプレーヤー操作" title="その他">
                  <%- icon('more') %>
                </summary>
                <div class="watch-more-menu">
                  <button id="pipButton" class="watch-menu-action" type="button"><%- icon('pip') %><span>ミニプレーヤー</span></button>
                  <button id="theaterButton" class="watch-menu-action" type="button"><%- icon('screen') %><span>シアターモード</span></button>
                  <button id="streamInfoButton" class="watch-menu-action" type="button"><%- icon('settings') %><span>ストリーム情報</span></button>
                </div>
              </details>
            </div>
          </div>

          <!-- Description Box (Expandable Card) -->
          <div id="descriptionBox" class="description-box" tabindex="0" aria-expanded="false">
            <div class="description-meta">
              <% if (video.views) { %><b><%= video.views %></b><% } %>
              <% if (video.published) { %><span><%= /前$| ago$/i.test(video.published) ? `${video.published.replace(/\s+/g, '')}に投稿` : video.published %></span><% } %>
            </div>
            <div id="descriptionText" class="description-text">
              <p><%= video.description || '説明はありません。' %></p>
            </div>
            <button id="descriptionToggle" class="description-toggle" type="button">もっと見る</button>
          </div>

          <!-- Comments Section (Open by default on Desktop) -->
          <button id="mobileCommentsOpen" class="mobile-comments-open" type="button" aria-expanded="false" aria-controls="commentsSection">
            <%- icon('news') %><span>コメントを表示</span><%- icon('chevron-right', 'icon') %>
          </button>
          <button id="mobileCommentsScrim" class="mobile-comments-scrim" type="button" aria-label="コメントを閉じる" hidden></button>
          <section id="commentsSection" class="comments-section">
            <div class="comments-header">
              <h2 id="commentsCountHeader">コメント</h2>
              <button id="mobileCommentsClose" class="mobile-comments-close" type="button" aria-label="コメントを閉じる">閉じる</button>
              <div class="comments-sort-wrap">
                <button id="commentsSortBtn" class="text-btn comments-sort-btn" type="button">
                  <%- icon('filter') %>
                  <span id="commentsSortLabel">並び替え</span>
                </button>
                <div id="commentsSortMenu" class="comments-sort-menu" hidden>
                  <button type="button" data-sort="top" class="active">評価順</button>
                  <button type="button" data-sort="new">新しい順</button>
                </div>
              </div>
            </div>

            <!-- Comment Composer -->
            <form id="commentComposer" class="comment-composer">
              <div class="comment-composer-avatar">
                <span class="comment-avatar fallback"><%= authenticated ? '✓' : 'W' %></span>
              </div>
              <div class="comment-composer-main">
                <textarea id="commentText" maxlength="10000" placeholder="コメントを追加..." rows="1"></textarea>
                <div id="commentComposerActions" class="comment-composer-actions" hidden>
                  <button id="cancelCommentBtn" type="button" class="btn-text">キャンセル</button>
                  <button id="submitCommentBtn" type="submit" class="btn-primary" disabled>コメント</button>
                </div>
              </div>
            </form>

            <!-- Comments List -->
            <div id="commentsList" class="comments-list">
              <div class="comments-loading">コメントを読み込み中…</div>
            </div>
          </section>
        </section>

        <!-- Right Side: Related Videos & Autoplay -->
        <aside class="related"<% if (feedToken) { %> data-feed-token="<%= feedToken %>" data-feed-kind="related"<% } %>>
          <% if (isLive || liveChatReplayAvailable) { %>
            <% if (liveChatReplayAvailable && !isLive) { %>
              <button id="liveChatReplayToggle" class="live-chat-replay-toggle" type="button" aria-expanded="false">チャットのリプレイを表示</button>
            <% } %>
            <section id="liveChatPanel" class="live-chat-panel" aria-label="<%= isLive ? 'ライブチャット' : 'チャットのリプレイ' %>"<% if (!isLive) { %> hidden<% } %>>
              <header class="live-chat-header">
                <h2><%= isLive ? 'ライブチャット' : 'チャットのリプレイ' %></h2>
                <div class="live-chat-tools">
                  <span id="liveChatStatus" class="live-chat-status">接続中…</span>
                  <% if (liveChatAvailable) { %>
                    <label class="live-chat-filter-label" for="liveChatFilter">表示</label>
                    <select id="liveChatFilter" aria-label="チャット表示フィルター">
                      <option value="TOP_CHAT">トップチャット</option>
                      <option value="LIVE_CHAT">すべてのチャット</option>
                    </select>
                  <% } %>
                </div>
              </header>
              <% if (liveChatAvailable) { %>
                <ol id="liveChatMessages" class="live-chat-messages" aria-live="polite" aria-relevant="additions text">
                  <li class="live-chat-placeholder">チャットを読み込んでいます…</li>
                </ol>
              <% } else { %>
                <div class="live-chat-placeholder">この配信ではライブチャットを利用できません。</div>
              <% } %>
            </section>
          <% } %>
          <div class="related-chips">
            <span class="chip selected">すべて</span>
            <div class="autoplay-toggle-wrap">
              <label class="switch-label" for="autoplayToggle">自動再生</label>
              <label class="switch">
                <input id="autoplayToggle" type="checkbox">
                <span class="slider"></span>
              </label>
            </div>
          </div>

          <div class="related-list">
            <% videos.forEach(v => { %>
              <div class="related-card-wrap">
                <a class="related-card" href="<%= v.isShort ? '/shorts/' + encodeURIComponent(v.id) : '/watch?v=' + v.id %>" data-video-id="<%= v.id %>">
                  <div class="related-thumb">
                    <img src="<%= v.thumbnail %>" alt="" loading="lazy">
                    <% if (v.duration) { %>
                      <span class="duration"><%= v.duration %></span>
                    <% } %>
                    <% if (v.isShort) { %>
                      <span class="shorts-video-badge">Shorts</span>
                    <% } %>
                  </div>
                  <div class="related-info">
                    <b class="related-title"><%= v.title %></b>
                    <span class="related-channel"><%= v.author %></span>
                    <span class="related-meta"><%= v.views || '再生回数不明' %></span>
                  </div>
                </a>
                <button class="more-btn related-more-btn" aria-label="その他のアクション" data-video-id="<%= v.id %>" data-title="<%= v.title %>"><%- icon('more') %></button>
              </div>
            <% }) %>
          </div>
        </aside>
      </div>

      <!-- Mini Player Floater -->
      <div id="miniPlayer" class="mini-player" hidden>
        <div class="mini-player-header">
          <button id="miniPlayerTitle" class="mini-player-title" type="button" title="動画ページに戻る"><%= video.title %></button>
          <div class="mini-player-actions">
            <button id="miniPlayerPlayPause" title="一時停止" aria-label="一時停止"><%- icon('pause') %></button>
            <button id="miniPlayerExpand" title="通常プレイヤーに戻る"><%- icon('screen') %></button>
            <button id="miniPlayerClose" title="閉じる">×</button>
          </div>
        </div>
        <div id="miniPlayerVideoSlot" class="mini-player-slot"></div>
      </div>
    <% } %>

    <!-- Channel Page -->
    <% if (page === 'channel' && entity) { %>
      <section class="channel-page" data-channel-id="<%= entity.id %>">
        <div class="channel-banner<%= entity.banner ? ' has-image' : '' %>">
          <% if (entity.banner) { %>
            <img src="<%= entity.banner %>" alt="" loading="eager">
          <% } %>
        </div>
        <div class="channel-header">
          <div class="channel-header-main">
            <% if (entity.image) { %>
              <img class="channel-avatar-xl" src="<%= entity.image %>" alt="<%= entity.title %>">
            <% } else { %>
              <span class="channel-avatar-xl fallback"><%= entity.title.slice(0, 1) %></span>
            <% } %>
            <div class="channel-identity">
              <div class="channel-title-row">
                <h1><%= entity.title %></h1>
                <% if (entity.verified) { %>
                  <span class="channel-verified" title="認証済み">✓</span>
                <% } %>
              </div>
              <div class="channel-handle"><%= entity.handle || '' %><% if (entity.subscribers) { %>　<%= entity.subscribers %><% } %><% if (entity.videosCount) { %>　<%= entity.videosCount %><% } %></div>
              <% if (entity.description) { %>
                <p class="channel-description"><%= entity.description %></p>
              <% } %>
              <div class="channel-actions">
                <button id="channelSubscribeButton" class="channel-subscribe" data-channel-id="<%= entity.id %>">チャンネル登録</button>
                <button class="channel-action" type="button" onclick="navigator.clipboard?.writeText(location.href);notify('リンクをコピーしました');">共有</button>
              </div>
            </div>
          </div>
        </div>
        <nav class="channel-tabs" aria-label="チャンネル タブ">
          <% const channelTabs = [['home','ホーム',entity.tabs.home],['videos','動画',entity.tabs.videos],['shorts','ショート',entity.tabs.shorts],['live','ライブ',entity.tabs.live],['playlists','再生リスト',entity.tabs.playlists],['community','コミュニティ',entity.tabs.community],['about','概要',entity.tabs.about]]; %>
          <% channelTabs.forEach(([key, label, enabled]) => { if (enabled) { %>
            <a class="<%= entity.tab === key ? 'active' : '' %>" href="/channel/<%= encodeURIComponent(entity.id) %>?tab=<%= key %>"><%= label %></a>
          <% } }) %>
          <form class="channel-search" action="/channel/<%= encodeURIComponent(entity.id) %>">
            <input type="hidden" name="tab" value="home">
            <input name="q" value="<%= entity.query || '' %>" placeholder="チャンネル内を検索" aria-label="チャンネル内を検索">
            <button type="submit">⌕</button>
          </form>
        </nav>

        <% if (entity.tab === 'about') { %>
          <section class="channel-about">
            <div class="channel-about-main">
              <h2>概要</h2>
              <p><%= entity.description || 'このチャンネルには説明がありません。' %></p>
            </div>
            <aside class="channel-about-side">
              <h2>チャンネルの詳細</h2>
              <% if (entity.externalUrl) { %><p><a href="<%= entity.externalUrl %>" target="_blank" rel="noopener">チャンネルURL</a></p><% } %>
              <% if (entity.about?.views) { %><p>総再生回数　<b><%= entity.about.views %></b></p><% } %>
              <% if (entity.about?.joined) { %><p>登録日　<b><%= entity.about.joined %></b></p><% } %>
              <% if (entity.about?.country) { %><p>所在地　<b><%= entity.about.country %></b></p><% } %>
            </aside>
          </section>
        <% } else if (entity.tab === 'home' && channelContent.featured) { %>
          <section class="channel-featured">
            <a class="channel-featured-thumb" href="/watch?v=<%= channelContent.featured.id %>">
              <img src="<%= channelContent.featured.thumbnail %>" alt="" loading="eager">
              <% if (channelContent.featured.duration) { %><span><%= channelContent.featured.duration %></span><% } %>
            </a>
            <div class="channel-featured-copy">
              <span class="channel-section-kicker">最新の動画</span>
              <a href="/watch?v=<%= channelContent.featured.id %>"><h2><%= channelContent.featured.title %></h2></a>
              <p><%= channelContent.featured.views || '' %><% if (channelContent.featured.published) { %> ・ <%= channelContent.featured.published %><% } %></p>
              <p class="channel-featured-description"><%= channelContent.featured.description || '' %></p>
            </div>
          </section>
          <section class="channel-section">
            <div class="channel-section-head">
              <h2>動画</h2>
              <a href="/channel/<%= encodeURIComponent(entity.id) %>?tab=videos">すべて見る</a>
            </div>
            <div class="video-grid channel-video-grid">
              <% channelContent.uploads.forEach(v => { %>
                <article class="video-card">
                  <a class="thumb" href="/watch?v=<%= v.id %>">
                    <img src="<%= v.thumbnail %>" alt="" loading="lazy">
                    <% if (v.duration) { %><span class="duration"><%= v.duration %></span><% } %>
                  </a>
                  <div class="card-info">
                    <% if (entity.image) { %>
                      <img class="channel-avatar" src="<%= entity.image %>" alt="">
                    <% } else { %>
                      <span class="channel-avatar fallback"><%= entity.title.slice(0, 1) %></span>
                    <% } %>
                    <div class="card-copy">
                      <a class="video-title" href="/watch?v=<%= v.id %>"><%= v.title %></a>
                      <span><%= v.views || '' %></span>
                      <span><%= v.published || '' %></span>
                    </div>
                    <button class="more-btn" aria-label="その他のアクション" data-video-id="<%= v.id %>" data-title="<%= v.title %>"><%- icon('more') %></button>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        <% } else { %>
          <section class="channel-section channel-listing">
            <div class="channel-section-head">
              <h2><%= entity.tab === 'videos' ? '動画' : entity.tab === 'shorts' ? 'ショート' : entity.tab === 'live' ? 'ライブ' : entity.tab === 'playlists' ? '再生リスト' : entity.tab === 'community' ? 'コミュニティ' : 'チャンネル' %></h2>
              <span><%= videos.length %>件</span>
            </div>
            <% if (videos.length) { %>
              <div class="video-grid channel-video-grid">
                <% videos.forEach(v => { %>
                  <article class="video-card <%= v.isPlaylist ? 'playlist-card' : '' %>">
                    <a class="thumb" href="<%= v.isPlaylist ? '/playlist?list=' + encodeURIComponent(v.id) : v.isShort ? '/shorts/' + v.id : '/watch?v=' + v.id %>">
                      <img src="<%= v.thumbnail %>" alt="" loading="lazy">
                      <% if (v.isPlaylist) { %>
                        <div class="playlist-overlay"><%- icon('playlist') %><span><%= v.count || '再生リスト' %></span></div>
                      <% } else if (v.duration) { %>
                        <span class="duration"><%= v.duration %></span>
                      <% } %>
                    </a>
                    <div class="card-info">
                      <div class="card-copy">
                        <a class="video-title" href="<%= v.isPlaylist ? '/playlist?list=' + encodeURIComponent(v.id) : v.isShort ? '/shorts/' + v.id : '/watch?v=' + v.id %>"><%= v.title %></a>
                        <span><%= v.views || v.count || '' %></span>
                        <span><%= v.published || '' %></span>
                      </div>
                      <button class="more-btn" aria-label="その他のアクション" data-video-id="<%= v.id %>" data-title="<%= v.title %>"><%- icon('more') %></button>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="channel-empty">
                <h2>コンテンツがありません</h2>
                <p>このタブには現在表示できるコンテンツがありません。</p>
              </div>
            <% } %>
          </section>
        <% } %>
      </section>
    <% } %>

    <!-- Library Page (History, Watch Later, Liked, Subscriptions) -->
    <% if (page === 'library') {
      const libraryMeta = {
        subscriptions: { description: '登録しているチャンネル', icon: 'sub' },
        history: { description: '視聴した動画', icon: 'history' },
        watchLater: { description: '後で見るに保存した動画', icon: 'clock' },
        likedVideos: { description: '高く評価した動画', icon: 'like' }
      }[libraryType] || { description: '保存したコンテンツ', icon: 'clock' };
    %>
      <section class="library-page yt-library" data-library="<%= libraryType %>">
        <header class="yt-library-header">
          <div class="yt-library-icon"><%- icon(libraryMeta.icon) %></div>
          <div>
            <h1><%= title %></h1>
            <p><%= libraryMeta.description %></p>
          </div>
          <div class="yt-library-actions">
            <% if (libraryType === 'watchLater' || libraryType === 'likedVideos') { %>
              <button id="playAllBtn" class="pill active"><%- icon('screen') %><span>すべて再生</span></button>
            <% } %>
            <button id="refreshLibrary" class="yt-icon-button" title="更新" aria-label="更新"><%- icon('history') %></button>
            <button id="clearLibrary" class="yt-text-button">すべて削除</button>
          </div>
        </header>
        <div class="yt-library-controls">
          <div class="yt-filter-chips">
            <button class="active" data-library-filter="all">すべて</button>
            <button data-library-filter="recent">最近追加</button>
          </div>
          <div class="yt-library-tools">
            <label class="yt-library-search">
              <%- icon('search') %>
              <input id="librarySearch" type="search" placeholder="検索" aria-label="このライブラリを検索">
            </label>
            <select id="librarySort" aria-label="並び順">
              <option value="default">標準</option>
              <option value="title">タイトル順</option>
            </select>
            <span id="libraryCount" class="yt-library-count"></span>
          </div>
        </div>
        <div id="libraryStatus" class="yt-library-status">
          <span class="yt-loading-ring"></span><span>読み込み中...</span>
        </div>
        <section id="libraryGrid" class="video-grid yt-library-grid"></section>
      </section>
    <% } %>

    <!-- Playlist Collection Page -->
    <% if (page === 'collection' && entity) { %>
      <div class="playlist-page">
        <aside class="playlist-sidebar">
          <div class="playlist-cover">
            <img src="<%= entity.image %>" alt="<%= entity.title %>">
          </div>
          <h1 class="playlist-title"><%= entity.title %></h1>
          <p class="playlist-author"><%= entity.author %></p>
          <div class="playlist-meta"><%= videos.length %> 本の動画</div>
          <div class="playlist-actions">
            <% if (videos.length) { %>
              <a href="/watch?v=<%= videos[0].id %>" class="pill active"><%- icon('screen') %><span>すべて再生</span></a>
            <% } %>
          </div>
          <% if (entity.description) { %>
            <p class="playlist-desc"><%= entity.description %></p>
          <% } %>
        </aside>
        <section class="playlist-videos">
          <% videos.forEach((v, idx) => { %>
            <article class="playlist-item">
              <span class="playlist-index"><%= idx + 1 %></span>
              <a class="thumb" href="/watch?v=<%= v.id %>">
                <img src="<%= v.thumbnail %>" alt="" loading="lazy">
                <% if (v.duration) { %><span class="duration"><%= v.duration %></span><% } %>
              </a>
              <div class="playlist-item-info">
                <a class="video-title" href="/watch?v=<%= v.id %>"><%= v.title %></a>
                <span class="channel-name"><%= v.author %></span>
              </div>
            </article>
          <% }) %>
        </section>
      </div>
    <% } %>

    <!-- Error Page -->
    <% if (page === 'error') { %>
      <div class="empty">
        <h1>うまく読み込めませんでした</h1>
        <p><%= error %></p>
        <a href="/" class="pill">ホームへ戻る</a>
      </div>
    <% } %>
  </main>

  <!-- Mobile Bottom Navigation Bar -->
  <nav class="bottom-nav">
    <a href="/" class="bottom-item <%= page === 'home' ? 'active' : '' %>"><%- icon("home") %><span>ホーム</span></a>
    <a href="/shorts" class="bottom-item <%= page === 'shorts' ? 'active' : '' %>"><%- icon("shorts") %><span>Shorts</span></a>
    <a href="/subscriptions" class="bottom-item <%= libraryType === 'subscriptions' ? 'active' : '' %>"><%- icon("sub") %><span>登録</span></a>
    <a href="/history" id="mobileHistory" class="bottom-item <%= libraryType === 'history' || page === 'channel' ? 'active' : '' %>"><%- icon("history") %><span>履歴</span></a>
  </nav>

  <!-- Card Action Dropdown Menu (Context Menu) -->
  <div id="cardActionMenu" class="card-action-menu" hidden>
    <button id="cardActionQueue" class="card-action-item"><%- icon('playlist') %><span>キューに追加</span></button>
    <button id="cardActionSave" class="card-action-item"><%- icon('clock') %><span>後で見るに保存</span></button>
    <button id="cardActionShare" class="card-action-item"><%- icon('share') %><span>共有</span></button>
    <button id="cardActionCopy" class="card-action-item"><%- icon('share') %><span>リンクをコピー</span></button>
  </div>

  <!-- Stream Info Dialog -->
  <div id="streamInfoDialog" class="modal-panel stream-info-dialog" hidden>
    <div>
      <button class="modal-close" aria-label="閉じる">×</button>
      <div class="stream-dialog-head">
        <span class="stream-dialog-icon">↓</span>
        <div>
          <h2>動画をダウンロード</h2>
          <p>利用可能な画質・形式を選択してください。</p>
        </div>
      </div>
      <div id="streamVideoTitle" class="stream-video-title" hidden></div>
      <div id="streamInfoList" class="stream-info-list"><p class="muted">読み込み中…</p></div>
      <p class="stream-dialog-footnote">※ ダウンロードURLは一時的なものです。必要な場合は再取得してください。</p>
    </div>
  </div>

  <!-- Theme Selection Dialog -->
  <div id="themeDialog" class="modal-panel theme-dialog" hidden>
    <div>
      <button class="modal-close" aria-label="閉じる">×</button>
      <h2>デザイン</h2>
      <p class="dialog-subtitle">このブラウザにのみ適用されます</p>
      <div class="theme-options">
        <label class="theme-option">
          <input type="radio" name="themeSelect" value="device">
          <span>端末の設定を使用</span>
        </label>
        <label class="theme-option">
          <input type="radio" name="themeSelect" value="dark">
          <span>ダークテーマ</span>
        </label>
        <label class="theme-option">
          <input type="radio" name="themeSelect" value="light">
          <span>ライトテーマ</span>
        </label>
      </div>
    </div>
  </div>

  <!-- YouTube TV OAuth Dialog -->
  <div id="authDialog" class="modal-panel auth-dialog" hidden>
    <div>
      <button class="modal-close" aria-label="閉じる">×</button>
      <div id="authSignedOut">
        <h2>YouTubeアカウントでログイン</h2>
        <p>テレビ認証を使ってログインすると、あなたのアカウントの再生履歴、登録チャンネル、おすすめを同期できます。</p>
        <button id="startAuthButton" class="auth-primary">テレビ認証を開始</button>
      </div>
      <div id="authPending" class="auth-state" hidden>
        <div class="auth-hero">
          <span class="auth-hero-icon">✓</span>
          <div>
            <h2>テレビでログイン</h2>
            <p>スマートフォンやPCでYouTubeを開いて、下のコードを入力してください。</p>
          </div>
        </div>
        <div class="auth-steps">
          <div><b>1</b><span>認証ページを開く</span></div>
          <div><b>2</b><span>表示されたコードを入力</span></div>
          <div><b>3</b><span>ログイン完了を待つ</span></div>
        </div>
        <a id="authVerificationLink" class="auth-link" href="https://www.youtube.com/activate" target="_blank" rel="noopener noreferrer">
          <span>認証ページを開く</span><b>↗</b>
        </a>
        <div class="auth-code-wrap">
          <span class="auth-code-label">認証コード</span>
          <button id="copyAuthCode" class="auth-code" type="button" title="クリックしてコピー" aria-label="認証コードをコピー"></button>
          <small>コードをクリックするとコピーできます</small>
        </div>
        <p id="authCountdown" class="auth-muted">認証を待っています…</p>
      </div>
      <div id="authSignedIn" hidden>
        <h2>ログイン済み</h2>
        <div class="auth-account">
          <span id="authAccountAvatar" class="account-avatar">✓</span>
          <div>
            <b id="authAccountName">YouTubeアカウント</b>
            <small id="authAccountHandle"></small>
          </div>
        </div>
        <button id="signOutButton" class="auth-danger">ログアウト</button>
      </div>
      <div id="authError" hidden>
        <h2>認証エラー</h2>
        <p id="authErrorMessage"></p>
        <button id="retryAuthButton" class="auth-primary">再試行</button>
      </div>
    </div>
  </div>

  <!-- Queue Side/Bottom Panel -->
  <aside id="queuePanel" class="queue-panel" aria-hidden="true">
    <div class="queue-head">
      <h2>再生キュー</h2>
      <button id="closeQueue" aria-label="閉じる">×</button>
    </div>
    <div id="queueList"></div>
    <div class="queue-actions">
      <button id="clearQueue">キューを消去</button>
    </div>
  </aside>

  <!-- Keyboard Shortcuts Dialog -->
  <div id="shortcutsDialog" class="modal-panel shortcuts-dialog" hidden>
    <div>
      <button class="modal-close" aria-label="閉じる">×</button>
      <h2>キーボード ショートカット</h2>
      <div class="shortcuts-grid">
        <div class="shortcut-group">
          <h3>再生</h3>
          <p><kbd>k</kbd> または <kbd>Space</kbd> <span>再生 / 一時停止</span></p>
          <p><kbd>j</kbd> / <kbd>l</kbd> <span>10 秒戻る / 進む</span></p>
          <p><kbd>←</kbd> / <kbd>→</kbd> <span>5 秒戻る / 進む</span></p>
          <p><kbd>0</kbd>〜<kbd>9</kbd> <span>動画の 0%〜90% へ移動</span></p>
          <p><kbd>Shift</kbd> + <kbd>&gt;</kbd> / <kbd>&lt;</kbd> <span>速度を上げる / 下げる</span></p>
        </div>
        <div class="shortcut-group">
          <h3>全般 & 表示</h3>
          <p><kbd>/</kbd> <span>検索バーへ移動</span></p>
          <p><kbd>t</kbd> <span>シアターモード</span></p>
          <p><kbd>f</kbd> <span>全画面表示</span></p>
          <p><kbd>i</kbd> <span>ミニプレーヤー</span></p>
          <p><kbd>m</kbd> <span>ミュート</span></p>
          <p><kbd>Esc</kbd> <span>ダイアログやメニューを閉じる</span></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast" role="status"></div>

  <!-- Load YouTube Iframe API for Rich Player Controls -->
  <script src="https://www.youtube.com/iframe_api" async></script>
  <script src="/app.js?v=2.9.55" defer></script>
  <script src="/scripts/app-theme.js?v=2.9.41" defer></script>
  <script src="/scripts/app-header.js?v=2.9.48" defer></script>
  <script src="/scripts/app-card-actions.js?v=2.9.41" defer></script>
  <script src="/scripts/app-watch.js?v=2.9.49" defer></script>
  <script src="/scripts/app-recommendations.js?v=2.9.59" defer></script>
  <script src="/scripts/app-shorts.js?v=2.9.52" defer></script>
  <script src="/scripts/app-library.js?v=2.9.43" defer></script>
  <script src="/scripts/app-sidebar.js?v=2.9.41" defer></script>
  <script src="/scripts/app-auth.js?v=2.9.41" defer></script>
  <script src="/scripts/app-progress.js?v=2.9.41" defer></script>
  <script src="/scripts/app-queue.js?v=2.9.41" defer></script>
  <script src="/scripts/app-keyboard.js?v=2.9.41" defer></script>
  <script src="/scripts/app-channel.js?v=2.9.41" defer></script>
  <script src="/scripts/app-library-controls.js?v=2.9.41" defer></script>
  <script src="/scripts/app-feed-pagination.js?v=2.9.41" defer></script>
  <script src="/scripts/app-settings.js?v=2.9.55" defer></script>
</body>
