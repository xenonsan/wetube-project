<!doctype html>
<html lang="ja" data-theme="device">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="dark light">
  <title><%= title %> | YouTube</title>
  <link rel="stylesheet" href="/style.css?v=2.9.57">
  <% if (page === 'settings') { %>
    <link rel="stylesheet" href="/styles/settings-page.css?v=2.9.44">
  <% } %>
  <% if (page === 'watch') { %>
    <link rel="stylesheet" href="/watch.css?v=2.9.49">
  <% } %>
</head>
<body data-page="<%= page %>" data-authenticated="<%= authenticated ? 'true' : 'false' %>"<% if (video) { %> data-video-id="<%= video.id %>"<% } %><% if (page === 'watch' && isLive) { %> data-live="true"<% } %><% if (page === 'watch') { %> data-live-chat-mode="<%= liveChatMode %>"<% } %>>
  <div id="pageProgress" class="page-progress" aria-hidden="true"><span></span></div>

  <!-- SVG Sprite Definitions -->
  <svg class="sprite" aria-hidden="true"><defs>
    <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6.5h16M4 12h16M4 17.5h16"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 10.5 8.5-7 8.5 7"/><path d="M5.5 9.5v10h5.2v-6h2.6v6h5.2v-10"/></symbol>
    <symbol id="i-shorts" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.2 6.6 14 4.3c2.9-1 4.5 3.1 1.6 4.2l-7.3 2.7c-3 1.1-2.5 4.1.1 5l6.2 2.2c2.8 1 4.3-3 1.5-4l-6.2-2.3" stroke-width="2.4"/>
      <path d="m10.6 9.8 4.1 2.2-4.1 2.3z" fill="currentColor" stroke="none"/>
    </symbol>
    <symbol id="i-sub" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></symbol>
    <symbol id="i-history" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 11a8.5 8.5 0 1 1 2.1 6.1"/><path d="M3.5 5.5V11h5.5M12 7.5V12l3 2"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></symbol>
    <symbol id="i-fire" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 22a7 7 0 0 0 7-7c0-3.1-1.5-5.7-4.2-8.5-.1 2.2-1 3.5-2.3 4.2C13.2 6.4 10.4 3.4 7 2c.4 4.2-.6 6.4-2.1 8.8A7.1 7.1 0 0 0 12.5 22Z"/><path d="M12.5 22a3.5 3.5 0 0 0 3.5-3.5c0-1.5-.7-2.7-2.1-4.2-.2 1.1-.7 1.8-1.5 2.2-.4-1.8-1.3-2.8-2.7-3.7.1 2-.4 3.1-1.2 4.2a3.5 3.5 0 0 0 4 5Z"/></symbol>
    <symbol id="i-music" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></symbol>
    <symbol id="i-game" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 8h11a4.5 4.5 0 0 1 4.4 5.5l-1 4a2.5 2.5 0 0 1-4.1 1.3L14 16h-4l-2.8 2.8a2.5 2.5 0 0 1-4.1-1.3l-1-4A4.5 4.5 0 0 1 6.5 8Z"/><path d="M7 11v4m-2-2h4m6-1h.01M18 14h.01"/></symbol>
    <symbol id="i-news" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 15.2A8.8 8.8 0 0 1 8.8 3.5 9.4 9.4 0 1 0 20.5 15.2Z"/></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></symbol>
    <symbol id="i-like" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v10H4a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1h3Zm0 0 5-7a3 3 0 0 1 1.8 3.8L13 10h5.8a2 2 0 0 1 2 2.4l-1.5 6a2 2 0 0 1-1.9 1.6H7"/></symbol>
    <symbol id="i-dislike" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14V4H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h3Zm0 0 5 7a3 3 0 0 0 1.8-3.8L13 14h5.8a2 2 0 0 0 2-2.4l-1.5-6A2 2 0 0 0 17.4 4H7"/></symbol>
    <symbol id="i-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.5m-7.6 6.9 7.6 4.5"/></symbol>
    <symbol id="i-screen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2.5"/><path d="M8 21h8m-4-4v4m-2-12 5 2.5-5 2.5z"/></symbol>
    <symbol id="i-pip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M12 12h6v5h-6z"/></symbol>
    <symbol id="i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4.8a1 1 0 0 1 1.5-.9l11 7.2a1.1 1.1 0 0 1 0 1.8l-11 7.2a1 1 0 0 1-1.5-.9z"/></symbol>
    <symbol id="i-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9m-8 12a2 2 0 0 0 4 0"/></symbol>
    <symbol id="i-filter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10m-7 6h4"/><circle cx="8" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="11" cy="18" r="1.6" fill="currentColor" stroke="none"/></symbol>
    <symbol id="i-playlist" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h11M4 11h11M4 16h7"/><path d="m16 14 5 3-5 3z"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2.2" fill="var(--bg, #0f0f0f)"/><circle cx="15" cy="12" r="2.2" fill="var(--bg, #0f0f0f)"/><circle cx="11" cy="18" r="2.2" fill="var(--bg, #0f0f0f)"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20v-1.5a7 7 0 0 1 14 0V20z"/></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="i-chevron-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></symbol>
  </defs></svg>
  <% const icon = (id, cls = 'icon') => `<svg class="${cls}" aria-hidden="true"><use href="#i-${id}"></use></svg>`; %>

  <!-- Topbar Header -->
  <header class="topbar">
    <div class="header-left">
      <button id="menuButton" class="icon-btn" aria-label="ガイドを開く/閉じる"><%- icon('menu') %></button>
      <a class="brand" href="/" aria-label="YouTube ホーム">
        <svg class="brand-logo" aria-hidden="true" viewBox="0 0 90 20" xmlns="http://www.w3.org/2000/svg">
